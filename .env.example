# =============================================================================
# .env.example: list of environment variables, WITHOUT real values.
# Copy to .env (never committed) and fill it in:
#   cp .env.example .env
# =============================================================================

# ---- PostgreSQL (docker-compose.yml) ----------------------------------------

POSTGRES_USER=justice
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=change-me
POSTGRES_DB=justice

# Connection URL read by Prisma (prisma.config.ts) and the app (src/lib/prisma.ts).
# Same credentials as above; localhost:5432 = the db container started by `npm run db:up`.
DATABASE_URL=postgresql://justice:change-me@localhost:5432/justice
