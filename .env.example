# =============================================================================
# .env.example : liste des variables d'environnement, SANS vraies valeurs.
# Copier en .env (jamais commité) puis remplir :
#   cp .env.example .env
# Commentaires sur leur propre ligne (pas en fin de ligne de valeur).
# =============================================================================

# ---- PostgreSQL (service `db` de docker-compose.yml) ------------------------

POSTGRES_USER=justice
# Générer : openssl rand -base64 24
POSTGRES_PASSWORD=change-me
POSTGRES_DB=justice

# ---- Application ------------------------------------------------------------

# URL de connexion lue par Prisma (prisma.config.ts) et l'app (src/lib/prisma.ts).
# - App lancée DANS Docker (`docker compose up`) : ignorée, docker-compose.yml
#   la reconstruit avec l'hôte `db`.
# - App lancée SUR ta machine (`npm run dev` + `npm run db:up`) : utilisée telle
#   quelle. Mêmes identifiants que ci-dessus.
DATABASE_URL=postgresql://justice:change-me@localhost:5432/justice
