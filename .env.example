# =============================================================================
# .env.example: list of environment variables, WITHOUT real values.
# Copy to .env (never committed) and fill it in:
#   cp .env.example .env
# Comments on their own line (not at the end of a value line).
# =============================================================================

# ---- PostgreSQL (`db` service of docker-compose.yml) ------------------------

POSTGRES_USER=justice
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=change-me
POSTGRES_DB=justice

# ---- Application ------------------------------------------------------------

# Connection URL read by Prisma (prisma.config.ts) and the server (src/server/prisma.ts).
# - App run INSIDE Docker (`docker compose up`): ignored, docker-compose.yml
#   rebuilds it with the `db` host.
# - App run ON your machine (`npm run dev` + `npm run db:up`): used as is.
#   Same credentials as above.
DATABASE_URL=postgresql://justice:change-me@localhost:5432/justice

# ---- IRIS chatbot (Ollama, service `ollama` of docker-compose.yml) ----------

# Same rule as DATABASE_URL: ignored when the app runs in Docker (it uses
# http://ollama:11434), used as is when the app runs on your machine.
OLLAMA_URL=http://localhost:11434
# Models (downloaded by the `ollama-models` service). The defaults run without
# a GPU. The chat model must NOT be a "thinking" model (qwen3:4b, qwen3:8b...):
# their reasoning is slow and can be cut before the answer. Qwen3 "instruct-2507"
# models answer directly.
OLLAMA_CHAT_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_EMBED_MODEL=bge-m3
